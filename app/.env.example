# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"
DATABASE_URL_UNPOOLED="postgres://user:password@host:port/db-name"

ORIGIN="http://127.0.0.1:5173"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
# GitHub OAuth
# https://www.better-auth.com/docs/authentication/github
# Register both callback URLs in the same GitHub OAuth app:
# http://127.0.0.1:5173/api/auth/callback/github
# https://concierge-pearl.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth callbacks: http://127.0.0.1:5173/api/auth/callback/google
# and https://concierge-pearl.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple Sign In is available only on HTTPS (localhost/127.0.0.1 callbacks are rejected by Apple).
# Domain: concierge-pearl.vercel.app
# Return URL: https://concierge-pearl.vercel.app/api/auth/callback/apple
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY_BASE64=""

# Server-side key for the reservation chat
OPENROUTER_API_KEY=""

# Geoapify key for area search, venues, and map tiles. Map tiles expose it to browsers;
# set a usage limit. A separate tile key can be origin-restricted later.
GEOAPIFY_API_KEY=""

# Server-side Google Maps Platform key with Weather API enabled
GOOGLE_WEATHER_API_KEY=""

# Server-side Browserbase key for reservation page discovery and Stagehand inspection
BROWSERBASE_API_KEY=""

# Hidden chat compaction: model metadata supplies the window unless overridden.
# An override can also set a smaller operational budget to control latency/cost.
# CHAT_CONTEXT_WINDOW="65536"
CHAT_CONTEXT_FRACTION="0.6"
