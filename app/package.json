{
	"name": "app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 127.0.0.1 --port 5173 --strictPort",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:e2e": "playwright test",
		"test:auth": "mkdir -p tests/.auth && playwright codegen --save-storage=tests/.auth/user.json http://127.0.0.1:5173/login",
		"eval:local": "bt eval --no-send-logs --no-input --runner bun --env-file .env.local tests/reservation.eval.ts",
		"lint": "prettier --ignore-path ../.gitignore --check . && eslint .",
		"format": "prettier --write .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@neondatabase/serverless": "^1.1.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"auth": "^1.6.23",
		"better-auth": "^1.6.23",
		"braintrust": "^3.35.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@ai-sdk/openai": "^4.0.78",
		"@ai-sdk/svelte": "^5.0.116",
		"@alexdev404/sficons-svelte": "^1.0.3",
		"@browserbasehq/stagehand": "^4.1.0",
		"@sentry/sveltekit": "^11",
		"ai": "^7.0.116",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"jose": "^6.2.12",
		"mapbox-gl": "^3.31.0",
		"openai": "^7.23.0",
		"tailwind-merge": "^3.7.0",
		"zod": "~4.4.3"
	}
}
